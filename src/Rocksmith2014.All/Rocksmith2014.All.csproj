<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Platforms>x64</Platforms>
    <PackageId>Rocksmith2014.All</PackageId>
    <Version>2.2.3</Version>
    <Description>All Rocksmith2014.NET libraries in a single package.</Description>
    <IncludeSymbols>false</IncludeSymbols>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);NU5100;NU5128</NoWarn>
    <TargetsForTfmSpecificBuildOutput>$(TargetsForTfmSpecificBuildOutput);BundleProjectReferences</TargetsForTfmSpecificBuildOutput>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Rocksmith2014.Audio\Rocksmith2014.Audio.fsproj" PrivateAssets="all" />
    <ProjectReference Include="..\Rocksmith2014.Common\Rocksmith2014.Common.fsproj" PrivateAssets="all" />
    <ProjectReference Include="..\Rocksmith2014.Conversion\Rocksmith2014.Conversion.fsproj" PrivateAssets="all" />
    <ProjectReference Include="..\Rocksmith2014.DD\Rocksmith2014.DD.fsproj" PrivateAssets="all" />
    <ProjectReference Include="..\Rocksmith2014.DD.Model\Rocksmith2014.DD.Model.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\Rocksmith2014.DLCProject\Rocksmith2014.DLCProject.fsproj" PrivateAssets="all" />
    <ProjectReference Include="..\Rocksmith2014.EOF\Rocksmith2014.EOF.fsproj" PrivateAssets="all" />
    <ProjectReference Include="..\Rocksmith2014.FSharpExtensions\Rocksmith2014.FSharpExtensions.fsproj" PrivateAssets="all" />
    <ProjectReference Include="..\Rocksmith2014.PSARC\Rocksmith2014.PSARC.fsproj" PrivateAssets="all" />
    <ProjectReference Include="..\Rocksmith2014.QuickEdit\Rocksmith2014.QuickEdit.fsproj" PrivateAssets="all" />
    <ProjectReference Include="..\Rocksmith2014.SNG\Rocksmith2014.SNG.fsproj" PrivateAssets="all" />
    <ProjectReference Include="..\Rocksmith2014.XML\Rocksmith2014.XML.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\Rocksmith2014.XML.Extension\Rocksmith2014.XML.Extension.fsproj" PrivateAssets="all" />
    <ProjectReference Include="..\Rocksmith2014.XML.Processing\Rocksmith2014.XML.Processing.fsproj" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FSharp.Core" />
    <PackageReference Include="FSharp.SystemTextJson" />
    <PackageReference Include="Microsoft.IO.RecyclableMemoryStream" />
    <PackageReference Include="Newtonsoft.Json" />
    <PackageReference Include="Magick.NET-Q8-x64" />
    <PackageReference Include="BunLabs.NAudio.Flac" />
    <PackageReference Include="Microsoft.Extensions.FileProviders.Embedded" />
    <PackageReference Include="NAudio.Core" />
    <PackageReference Include="NAudio.Vorbis" />
    <PackageReference Include="NVorbis" />
    <PackageReference Include="SimpleSIMD" />
    <PackageReference Include="Microsoft.ML" />
    <PackageReference Include="Microsoft.ML.FastTree" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\Rocksmith2014.DD.Model\MLModel.zip" Pack="true" PackagePath="contentFiles/any/any/" PackageCopyToOutput="true" Link="MLModel.zip" />
    <None Include="..\Rocksmith2014.Audio\Tools\packed_codebooks.bin" Pack="true" PackagePath="contentFiles/any/any/Tools/" PackageCopyToOutput="true" Link="Tools\packed_codebooks.bin" />
    <None Include="..\Rocksmith2014.Audio\Tools\packed_codebooks_aoTuV_603.bin" Pack="true" PackagePath="contentFiles/any/any/Tools/" PackageCopyToOutput="true" Link="Tools\packed_codebooks_aoTuV_603.bin" />
  </ItemGroup>

  <Target Name="BundleProjectReferences" DependsOnTargets="ResolveReferences">
    <ItemGroup>
      <BuildOutputInPackage Include="@(ReferenceCopyLocalPaths->WithMetadataValue('ReferenceSourceTarget', 'ProjectReference'))" Condition="'%(Extension)' == '.dll'" />
    </ItemGroup>
  </Target>

</Project>
